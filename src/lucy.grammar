// Lucy's grammar, following the hand-written parser in liblucy
// (src/core/parser/), which is the authority on the syntax.
//
// Lucy is line-based in one place: a transition ends at the end of its
// line, and an immediate transition is a line that starts with `=>`. So
// `=>` at the start of a line is a token of its own, ImmediateArrow, and
// anywhere else it's an Arrow that continues the transition before it.

@top Program { (statement | StateDeclaration)* }

statement {
  UseDeclaration |
  MachineDeclaration |
  ActionDeclaration |
  GuardDeclaration
}

UseDeclaration {
  kw<"use"> String UseGroup
}

UseGroup {
  "{" commaSep<VariableDefinition> "}"
}

MachineDeclaration {
  kw<"machine"> VariableDefinition MachineBlock
}

MachineBlock {
  "{" (ActionDeclaration | GuardDeclaration | EventDeclaration | InputDeclaration | StateDeclaration)* "}"
}

// `event name` or `event name(Type)`. A contextual keyword, as `event` is
// still an event's name inside a state.
EventDeclaration {
  ckw<"event"> VariableDefinition EventType?
}

EventType {
  "(" TypeName ")"
}

// `input name` or `input name(Type)`: a key of the context that whoever
// creates the machine supplies. A contextual keyword, like `event`.
InputDeclaration {
  ckw<"input"> VariableDefinition InputType?
}

InputType {
  "(" TypeName ")"
}

TypeName { identifier }

StateDeclaration {
  (ckw<"initial"> | ckw<"final">)? kw<"state"> VariableDefinition StateBlock
}

StateBlock {
  "{" (
    EventTransition |
    ImmediateTransition |
    DelayTransition |
    LocalTransition |
    InvokeDeclaration |
    MachineDeclaration
  )* "}"
}

InvokeDeclaration {
  kw<"invoke"> "(" reference ")" InvokeBlock
}

InvokeBlock {
  "{" EventTransition* "}"
}

ActionDeclaration {
  kw<"action"> VariableDefinition "=" (reference | InlineAssign | InlineSend)
}

GuardDeclaration {
  kw<"guard"> VariableDefinition "=" reference
}

// Transitions

EventTransition {
  (VariableName | OnEvent) Arrow transitionBody
}

// on(name), for an event named like a keyword: on(delay).
OnEvent {
  ckw<"on"> "(" (VariableName | keywordAsName) ")"
}

ImmediateTransition {
  ImmediateArrow transitionBody
}

DelayTransition {
  Delay Arrow transitionBody
}

// @entry => ... and @exit => ...: actions, with no guards or target.
LocalTransition {
  LocalName Arrow transitionBody
}

// The steps of a transition, `=>` between them: guards, actions and the
// target, in any order the compiler accepts. One may be a block, which can
// span lines: `go => { a =>\n b }`.
transitionBody {
  step (Arrow step)* (Arrow TransitionBlock)? |
  TransitionBlock
}

TransitionBlock {
  "{" step (Arrow step)* "}"
}

step {
  InlineGuard |
  InlineAction |
  InlineAssign |
  InlineSend |
  VariableName |
  Target
}

// A nested state: idle.errored.
Target {
  VariableName ("." VariableName)+
}

// Calls

Delay {
  kw<"delay"> "(" (Number | reference) ")"
}

InlineGuard {
  kw<"guard"> "(" reference ")"
}

InlineAction {
  kw<"action"> "(" reference ")"
}

InlineAssign {
  kw<"assign"> "(" VariableName ("," (reference | InlineSpawn))? ")"
}

InlineSpawn {
  kw<"spawn"> "(" reference ")" SpawnBlock?
}

// The inputs given to what is spawned, a `name = value` to a line:
// spawn(todoItem) { title = event.data }
SpawnBlock {
  "{" SpawnInput* "}"
}

SpawnInput {
  PropertyName "=" value
}

// A value is a reference, never an expression.
value {
  MemberValue |
  reference
}

// event.data or context.key. self, parent and functions are references.
MemberValue {
  VariableName "." PropertyName
}

// send(actor, event), or with a value for the event's data:
// send(parent, removed, self)
InlineSend {
  kw<"send"> "(" VariableName "," VariableName ("," value)? ")"
}

reference {
  VariableName |
  Symbol
}

VariableName { identifier }
VariableDefinition { identifier }
PropertyName { identifier }

keywordAsName {
  kw<"use"> | kw<"machine"> | kw<"state"> | kw<"action"> | kw<"guard"> |
  kw<"assign"> | kw<"invoke"> | kw<"delay"> | kw<"spawn"> | kw<"send">
}

commaSep<content> {
  "" | content ("," content?)*
}

// Keywords

kw<term> { @specialize[@name={term}]<identifier, term> }

// Contextual keywords, which are names elsewhere.

ckw<term> { @extend[@name={term}]<identifier, term> }

@skip { space | newline | LineComment | BlockComment }

@tokens {
  space { $[ \t]+ }

  newline { "\r"? "\n" }

  // `=>` first on a line, after any blank or space-only lines.
  ImmediateArrow { "\r"? "\n" ($[ \t]* "\r"? "\n")* $[ \t]* "=>" }

  LineComment { "//" ![\n]* }

  BlockComment { "/*" blockCommentRest }

  blockCommentRest { ![*] blockCommentRest | "*" blockCommentAfterStar }

  blockCommentAfterStar { "/" | "*" blockCommentAfterStar | ![/*] blockCommentRest }

  identifierChar { std.asciiLetter | $[_$\u{a1}-\u{10ffff}] }

  word { identifierChar (identifierChar | std.digit)* }

  identifier { word }

  Symbol { ":" word }

  LocalName { "@" word }

  // 200, 2s, 1m.
  Number { std.digit+ $[sm]* }

  String {
    '"' (![\\\n"] | "\\" _)* '"'? |
    "'" (![\\\n'] | "\\" _)* "'"?
  }

  Arrow { "=>" }

  @precedence { ImmediateArrow, newline }

  "(" ")" "{" "}" "," "=" "."
}

@detectDelim
